# ---------------------------------------------------------------------------
# Betlixx configuration. Everything deployment-specific is an environment
# variable; copy this to .env.local and fill in what your deployment needs.
# The app degrades rather than crashing when any of these is missing.
# ---------------------------------------------------------------------------

# Database. Without these the app degrades to upstream fixtures only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstream fixtures and odds. Without it the feed returns custom matches only.
API_FOOTBALL_KEY=

# Enables the admin console. Unset means the console is disabled entirely.
ADMIN_PASSWORD=

# Player accounts that skip the verification deposit, comma separated. Every
# sub-admin's own number is already exempt; this is for the operator's own
# account, which has no sub-admin record to be matched against. Any format.
VERIFICATION_EXEMPT_PHONES=

# One-time welcome bonus on the first confirmed deposit.
FIRST_DEPOSIT_BONUS=100

# Per-country minimum deposit and verification amount. MIN_DEPOSIT_<CC> is the
# floor on every top-up; MIN_FIRST_DEPOSIT_<CC> is the floor on the first one.
MIN_DEPOSIT_GH=300
MIN_FIRST_DEPOSIT_GH=300
VERIFICATION_AMOUNT_GH=300
MIN_DEPOSIT_NG=5000
MIN_FIRST_DEPOSIT_NG=5000
VERIFICATION_AMOUNT_NG=7500

# Per-country withdrawal gate. A count of 0 reverts that market to the older
# cumulative-total rule.
WITHDRAW_QUALIFY_COUNT_GH=4
WITHDRAW_QUALIFY_AMOUNT_GH=300
WITHDRAW_QUALIFY_COUNT_NG=4
WITHDRAW_QUALIFY_AMOUNT_NG=7500

# SMS delivery and the sender name players see.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Oddaroa

# The WhatsApp line on the deposit screen.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Bearer token the settlement cron must present.
CRON_SECRET=

# Caps on a partner crediting their own betting wallet. This is an agent float,
# not a deposit — it moves no money through a payment rail, so it is bounded and
# every credit is written to the operator's ledger.
PARTNER_CREDIT_MAX=5000
PARTNER_CREDIT_DAILY_MAX=20000

# --- Gateway credentials, per rail -----------------------------------------

# AlphaPay (alphapay.edibytes.online): the default rail. The account must
# whitelist every domain it collects from, under Domains in the AlphaPay
# dashboard. ALPHAPAY_DOMAIN forces which domain is sent; left empty, the
# site's own host is used. Amounts are the major unit; ALPHAPAY_UNIT=minor
# only if the checkout ever starts showing figures a hundred times too small.
ALPHAPAY_SECRET_KEY=
ALPHAPAY_PUBLIC_KEY=
ALPHAPAY_DOMAIN=
ALPHAPAY_UNIT=major

# Which rail each market uses, overriding the per-country default
# (e.g. GATEWAY_GH=manual). Valid: korapay, moolre, paystack, alphapay, manual.
GATEWAY_GH=
GATEWAY_NG=

KORAPAY_SECRET_KEY=

MOOLRE_API_KEY=
MOOLRE_API_USER=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=

PAYSTACK_SECRET_KEY=
